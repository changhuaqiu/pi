{
	"name": "logos-agent",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"bin": {
		"logos-agent": "./src/main.ts"
	},
	"scripts": {
		"start": "tsx src/main.ts",
		"test": "node --import tsx --test test/*.test.ts",
		"observability:install": "powershell -NoProfile -ExecutionPolicy Bypass -File observability/phoenix.ps1 install",
		"observability:start": "powershell -NoProfile -ExecutionPolicy Bypass -File observability/phoenix.ps1 start",
		"observability:status": "powershell -NoProfile -ExecutionPolicy Bypass -File observability/phoenix.ps1 status",
		"observability:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File observability/phoenix.ps1 stop"
	},
	"dependencies": {
		"@arizeai/phoenix-otel": "2.1.0",
		"@earendil-works/pi-agent-core": "0.81.1",
		"@earendil-works/pi-ai": "0.81.1",
		"@earendil-works/pi-tui": "0.81.1",
		"chalk": "5.6.2",
		"typebox": "1.1.38"
	},
	"devDependencies": {
		"tsx": "4.22.1",
		"typescript": "5.9.3"
	}
}
